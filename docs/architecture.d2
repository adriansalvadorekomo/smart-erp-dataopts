direction: right

"Source Systems": {
  postgres: "PostgreSQL OLTP\ncustomers · sellers · products\ninventory · orders · order_items" {
    style: {
      fill: "#E8EEF7"
      stroke: "#4169E1"
    }
  }
}

"Lakehouse (Medallion Architecture)": {
  direction: right

  bronze: "Bronze\nraw Delta (COPY INTO)" {
    style: {
      fill: "#FDECEA"
      stroke: "#FF3621"
    }
  }

  silver: "Silver\n6 clean entities" {
    style: {
      fill: "#FDECEA"
      stroke: "#FF3621"
    }
  }

  dq: "DQ gate R1–R9\nfail-fast" {
    style: {
      fill: "#FDECEA"
      stroke: "#FF3621"
    }
  }

  gold: "Gold marts\nfact_sales · sales_daily\ncustomer_360 · inventory_kpis" {
    style: {
      fill: "#FDECEA"
      stroke: "#FF3621"
    }
  }

  bronze -> silver: standardize
  silver -> dq: validate
  dq -> gold: certified
}

"Consumption Layers": {
  bi: "BI\nDatabricks SQL" {
    style: {
      fill: "#E6F4EA"
      stroke: "#1A7F37"
    }
  }

  ml: "ML\nXGBoost · churn · MLflow" {
    style: {
      fill: "#E6F4EA"
      stroke: "#1A7F37"
    }
  }

  ai: "AI\nGenie / RAG over Gold" {
    style: {
      fill: "#E6F4EA"
      stroke: "#1A7F37"
    }
  }
}

"Operational Components": {
  iac: "Terraform\nworkspace assets" {
    style: {
      fill: "#F3EAF7"
      stroke: "#7B42BC"
    }
  }

  ci: "PR-gated CI\ntests · sql guards · validate" {
    style: {
      fill: "#F3EAF7"
      stroke: "#7B42BC"
    }
  }
}

"Source Systems".postgres -> "Lakehouse (Medallion Architecture)".bronze: snapshot
"Lakehouse (Medallion Architecture)".gold -> "Consumption Layers".bi
"Lakehouse (Medallion Architecture)".gold -> "Consumption Layers".ml
"Lakehouse (Medallion Architecture)".gold -> "Consumption Layers".ai
"Operational Components".iac -> "Lakehouse (Medallion Architecture)".bronze: provisions
