# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Build / tool output
logs/
target/
dbt_packages/

# Local lakehouse scratch (Delta files) — prod equivalent is UC managed storage
lakehouse/delta/

# Terraform providers / state (local skeleton uses no remote backend)
infra/terraform/.terraform/
*.tfstate
*.tfstate.backup

# Raw datasets (large files — never commit)
data/amazon-e-commerce/*.csv
# Secrets — never commit (tokens, passwords via env / secret scopes only)
.env
.env.*
!.env.example
.opencode/
.sessions/